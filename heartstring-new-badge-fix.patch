+// Recomputes publishedAt whenever a card's isPublished flag is written.
+// Unpublishing clears it; publishing sets it only if it isn't already set, so an
+// edit that keeps a card published doesn't reset its New-badge clock, but an
+// unpublish -> republish cycle does (the card is genuinely newly available again).
+function resolvePublishedAt(nextPublished: boolean, existingPublishedAt: Date | null | undefined): Date | null {
+  if (!nextPublished) return null
+  return existingPublishedAt ?? new Date()
+}
