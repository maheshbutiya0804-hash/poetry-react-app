@@ -50,14 +50,36 @@ const publicCardSelect = {
   templateKey: true,
   frontLayout: true,
   backLayout: true,
+  createdAt: true,
 } as const
 
+// A card shows a "New" badge for this long after it's uploaded.
+const NEW_BADGE_WINDOW_MS = 14 * 24 * 60 * 60 * 1000
+// A card needs at least this many completed units sold to be eligible for "Most Bought".
+const MOST_BOUGHT_MIN_UNITS = 3
+// At most this many cards can show the "Most Bought" badge at once.
+const MOST_BOUGHT_LIMIT = 5
+
+// Cards ranked by total units sold across non-cancelled orders, highest first, capped at MOST_BOUGHT_LIMIT.
+async function getMostBoughtCardIds(): Promise<Set<string>> {
+  const groups = await prisma.cardOrder.groupBy({
+    by: ['cardId'],
+    where: { cardId: { not: null }, status: { not: 'CANCELLED' } },
+    _sum: { quantity: true },
+  })
+  const ranked = groups
+    .filter(g => (g._sum.quantity ?? 0) >= MOST_BOUGHT_MIN_UNITS)
+    .sort((a, b) => (b._sum.quantity ?? 0) - (a._sum.quantity ?? 0))
+    .slice(0, MOST_BOUGHT_LIMIT)
+  return new Set(ranked.map(g => g.cardId as string))
+}
