# Prisma CLI / migrations
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/heartstring_notes"

# Prisma 7 runtime adapter
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="YOUR_PASSWORD"
DB_NAME="heartstring_notes"

PORT="4000"
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Server-side authentication session
SESSION_COOKIE_NAME="heartstring_session"
SESSION_DAYS="7"

# Initial admin account. Use a strong unique password, then run: npm run admin:bootstrap
ADMIN_NAME="Heartstring Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_THIS_BEFORE_BOOTSTRAP"

# Google Identity Services (Web OAuth client ID; no client secret is required for ID-token sign-in)
GOOGLE_CLIENT_ID="512514958403-uefk5s6nt1uam0q0k1dfo9nibuud8re8.apps.googleusercontent.com"

# Twilio Programmable Messaging (server-side only)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-auth-token
TWILIO_PHONE_NUMBER=+14155550123
